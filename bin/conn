#!/usr/bin/env bash
# conn — Termux SSH connection + snippet manager (JuiceSSH replacement)
set -euo pipefail

CONN_HOME="${CONN_HOME:-$HOME/.config/conn}"
SNIP_DIR="$CONN_HOME/snippets"
SECRET_DIR="$CONN_HOME/secrets"
AGE_DIR="$CONN_HOME/age"
AGE_IDENTITY="${CONN_AGE_IDENTITY:-$AGE_DIR/identity.txt}"
AGE_RECIPIENT_FILE="$AGE_DIR/recipient.txt"
SSH_CONFIG="${CONN_SSH_CONFIG:-$HOME/.ssh/config}"
TMUX_CONF="${CONN_TMUX_CONF:-$HOME/.tmux.conf}"
SHORTCUTS_DIR="${CONN_SHORTCUTS_DIR:-$HOME/.shortcuts}"

die() { printf 'conn: %s\n' "$*" >&2; exit 1; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1 (try: pkg install $2)"
}

ensure_dirs() {
  mkdir -p "$SNIP_DIR" "$SECRET_DIR" "$AGE_DIR"
  [[ -f "$SSH_CONFIG" ]] || { mkdir -p "$(dirname "$SSH_CONFIG")"; : > "$SSH_CONFIG"; chmod 600 "$SSH_CONFIG"; }
}

usage() {
  cat <<'EOF'
conn — Termux SSH connection + snippet manager

  conn [connect] [-m] [HOST|N]   connect (fzf-pick, or by number, if HOST omitted; -m = mosh)
  conn list                      list hosts, numbered and grouped
  conn add                       append a Host block to ~/.ssh/config
  conn rm [HOST|N]               remove a Host (+ its secret/widget) from ~/.ssh/config
  conn edit                      open ~/.ssh/config in $EDITOR
  conn keygen [HOST...]          generate an ed25519 key, ssh-copy-id to HOSTs

  conn snip add NAME             create/edit a snippet
  conn snip ls                   list snippets
  conn snip rm NAME              delete a snippet
  conn snip [NAME]               pick a snippet, then copy / run local / run on host
  conn bind-key [KEY]            install a tmux popup keybinding (default: s)

  conn secret init               create an age identity for password holdouts
  conn secret add HOST           encrypt a host password with age (offers to
                                  auto-install a key on your next connect)
  conn secret rm HOST            remove a stored secret
  conn secret ls                 list hosts with stored secrets

  conn widgetize                 generate Termux:Widget launcher scripts
  conn sync init                 create a git repo for snippets + secrets
  conn sync remote URL           set the sync repo's remote
  conn sync [push|pull]          commit + push/pull the sync repo

  conn doctor                    check for required/optional dependencies
  conn help                      show this message
EOF
}

# --- ssh config helpers -----------------------------------------------

# Emits "alias<TAB>group" per non-wildcard Host alias, in config file order.
# A comment line "# Group: NAME" tags every Host block that follows it,
# until the next such comment (or "# Group: " with nothing after the colon,
# which resets to ungrouped).
list_hosts_meta() {
  [[ -f "$SSH_CONFIG" ]] || return 0
  awk '
    {
      lower = tolower($0)
      if (lower ~ /^[ \t]*#[ \t]*group[ \t]*:/) {
        line = $0
        sub(/^[^:]*:/, "", line)
        sub(/^[ \t]+/, "", line)
        sub(/[ \t]+$/, "", line)
        group = line
        next
      }
      if (tolower($1) == "host") {
        for (i = 2; i <= NF; i++) {
          if ($i !~ /[*?]/) printf "%s\t%s\n", $i, group
        }
      }
    }
  ' "$SSH_CONFIG"
}

list_hosts() {
  list_hosts_meta | cut -f1
}

# Populates HOST_ALIASES / HOST_GROUPS / HOST_LINES (1-indexed, numbered
# "N) [group] alias" display strings) from the current ssh config.
load_host_index() {
  HOST_ALIASES=()
  HOST_GROUPS=()
  HOST_LINES=()
  local alias group n=0
  while IFS=$'\t' read -r alias group; do
    [[ -n "$alias" ]] || continue
    n=$((n + 1))
    HOST_ALIASES+=("$alias")
    HOST_GROUPS+=("$group")
    if [[ -n "$group" ]]; then
      HOST_LINES+=("$(printf '%2d) [%s] %s' "$n" "$group" "$alias")")
    else
      HOST_LINES+=("$(printf '%2d) %s' "$n" "$alias")")
    fi
  done < <(list_hosts_meta)
}

# Resolves a 1-indexed number (as printed by `conn list` / the picker) to its alias.
host_by_number() {
  local n="$1"
  load_host_index
  (( n >= 1 && n <= ${#HOST_ALIASES[@]} )) || die "no host numbered $n (run: conn list)"
  printf '%s\n' "${HOST_ALIASES[$((n - 1))]}"
}

pick_host() {
  need_cmd fzf fzf
  load_host_index
  [[ ${#HOST_ALIASES[@]} -gt 0 ]] || die "no hosts in $SSH_CONFIG yet — run: conn add"
  local sel idx
  sel="$(printf '%s\n' "${HOST_LINES[@]}" | fzf --prompt='connect> ' --height='~40%' --reverse)"
  [[ -n "$sel" ]] || return 1
  idx="${sel%%)*}"
  idx="${idx//[[:space:]]/}"
  [[ "$idx" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "${HOST_ALIASES[$((idx - 1))]}"
}

cmd_list() {
  load_host_index
  if [[ ${#HOST_ALIASES[@]} -eq 0 ]]; then
    echo "conn: no hosts in $SSH_CONFIG yet — run: conn add"
    return
  fi
  printf '%s\n' "${HOST_LINES[@]}"
}

# --- connect ------------------------------------------------------------

cmd_connect() {
  local use_mosh=0 host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--mosh) use_mosh=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; break ;;
      -*) die "unknown flag: $1" ;;
      *) host="$1"; shift ;;
    esac
  done
  [[ -n "$host" ]] || host="$(pick_host)"
  [[ -n "$host" ]] || exit 1
  [[ "$host" =~ ^[0-9]+$ ]] && host="$(host_by_number "$host")"

  # Built as a shell-syntax string (not a bash array) because the age/sshpass
  # path needs a literal `<(...)` process substitution: an array assigned
  # now and exec'd later closes that fd before use, since the substitution
  # only lives for the assignment statement. Running the whole thing through
  # `bash -c` re-parses it fresh, so the substitution stays valid.
  local cmd_str secret_file="$SECRET_DIR/$host.age"
  local keyed_marker="$SECRET_DIR/$host.keyed"
  local autokey_marker="$SECRET_DIR/$host.autokey"

  if [[ -f "$secret_file" && ! -f "$keyed_marker" ]]; then
    need_cmd age age
    need_cmd sshpass sshpass
    [[ -f "$AGE_IDENTITY" ]] || die "no age identity at $AGE_IDENTITY (run: conn secret init, or copy one from another device)"
    [[ -f "$autokey_marker" ]] && maybe_bootstrap_key "$host" "$secret_file" "$keyed_marker"
  fi

  if [[ -f "$secret_file" && ! -f "$keyed_marker" ]]; then
    (( use_mosh )) && echo "conn: $host has a stored password; mosh needs key auth, using ssh instead" >&2
    cmd_str="$(printf 'sshpass -f <(age -d -i %q %q) ssh %q' "$AGE_IDENTITY" "$secret_file" "$host")"
  elif (( use_mosh )); then
    need_cmd mosh mosh
    cmd_str="$(printf 'mosh %q' "$host")"
  else
    need_cmd ssh openssh
    cmd_str="$(printf 'ssh %q' "$host")"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    exec bash -c "$cmd_str"
  fi

  need_cmd tmux tmux
  local session="conn-${host//[.:]/-}"
  exec tmux new-session -A -s "$session" "$cmd_str"
}

# --- add / edit / keygen -------------------------------------------------

cmd_add() {
  ensure_dirs
  local alias hostname user port identity group
  read -r -p "Alias (Host name, e.g. myserver): " alias
  [[ -n "$alias" ]] || die "alias is required"
  read -r -p "HostName (IP or DNS name): " hostname
  [[ -n "$hostname" ]] || die "HostName is required"
  read -r -p "User [$(id -un)]: " user
  user="${user:-$(id -un)}"
  read -r -p "Port [22]: " port
  port="${port:-22}"
  read -r -p "IdentityFile [~/.ssh/id_ed25519]: " identity
  identity="${identity:-~/.ssh/id_ed25519}"
  read -r -p "Group (optional, e.g. work): " group

  local last_group
  last_group="$(list_hosts_meta | tail -n1 | cut -f2)"

  {
    printf '\n'
    if [[ "$group" != "$last_group" ]]; then
      printf '# Group: %s\n' "$group"
    fi
    printf 'Host %s\n' "$alias"
    printf '    HostName %s\n' "$hostname"
    printf '    User %s\n' "$user"
    printf '    Port %s\n' "$port"
    printf '    IdentityFile %s\n' "$identity"
  } >> "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"
  echo "conn: added Host '$alias' to $SSH_CONFIG"

  local use_pw
  read -r -p "No key — password only? [y/N]: " use_pw
  if [[ "$use_pw" =~ ^[Yy] ]]; then
    cmd_secret_add "$alias"
  fi
}

# Offers to auto-install this device's key on HOST using its stored password,
# the first time `conn connect` runs against it — after that it stops needing
# the password at all.
offer_autokey() {
  local host="$1" auto_key
  read -r -p "No key added — create one and use it next time? [Y/n]: " auto_key
  if [[ ! "$auto_key" =~ ^[Nn] ]]; then
    ensure_default_key >/dev/null
    touch "$SECRET_DIR/$host.autokey"
    echo "conn: will install your key on '$host' automatically on your next connect"
  fi
}

cmd_rm() {
  local host="${1:-}"
  [[ -n "$host" ]] || host="$(pick_host)"
  [[ -n "$host" ]] || exit 1
  [[ "$host" =~ ^[0-9]+$ ]] && host="$(host_by_number "$host")"
  list_hosts | grep -qxF "$host" || die "no such host: $host"

  local tmp
  tmp="$(mktemp "${SSH_CONFIG}.XXXXXX")"
  awk -v target="$host" '
    BEGIN { skip = 0 }
    {
      line = $0
      if (line ~ /^[Hh]ost[ \t]+/) {
        skip = 0
        n = split(line, toks, /[ \t]+/)
        matched = 0
        rest = "Host"
        for (i = 2; i <= n; i++) {
          if (toks[i] == target) matched = 1
          else rest = rest " " toks[i]
        }
        if (matched && rest == "Host") { skip = 1; next }
        if (matched) { print rest; next }
      } else if (skip) {
        if (line ~ /^[ \t]*$/ || line ~ /^[ \t]/) next
        skip = 0
      }
      print line
    }
  ' "$SSH_CONFIG" > "$tmp"
  mv "$tmp" "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"
  echo "conn: removed Host '$host' from $SSH_CONFIG"

  if [[ -f "$SECRET_DIR/$host.age" ]]; then
    rm -f "$SECRET_DIR/$host.age" "$SECRET_DIR/$host.keyed" "$SECRET_DIR/$host.autokey"
    echo "conn: removed stored secret for '$host'"
  fi
  if [[ -f "$SHORTCUTS_DIR/ssh-$host.sh" ]]; then
    rm -f "$SHORTCUTS_DIR/ssh-$host.sh"
    echo "conn: removed widget shortcut for '$host'"
  fi
}

cmd_edit() {
  ensure_dirs
  "${EDITOR:-nano}" "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"
}

# Generates the default ed25519 key if it doesn't exist yet; always prints its path.
ensure_default_key() {
  local key="$HOME/.ssh/id_ed25519"
  mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
  if [[ ! -f "$key" ]]; then
    need_cmd ssh-keygen openssh
    ssh-keygen -t ed25519 -N "" -C "termux" -f "$key"
    chmod 600 "$key"
  fi
  printf '%s\n' "$key"
}

cmd_keygen() {
  local key="$HOME/.ssh/id_ed25519" existed=0
  [[ -f "$key" ]] && existed=1
  ensure_default_key >/dev/null
  (( existed )) && echo "conn: key already exists at $key"
  if [[ $# -gt 0 ]]; then
    need_cmd ssh-copy-id openssh
    for host in "$@"; do
      ssh-copy-id -i "${key}.pub" "$host"
    done
  else
    echo "conn: no hosts given — copy the key manually with: ssh-copy-id -i ${key}.pub HOST"
  fi
}

# Uses the stored age-encrypted password to install this device's public key
# on HOST via ssh-copy-id, so future connects can use key auth instead.
# Never fails the caller: on any error, the password path is used as normal.
maybe_bootstrap_key() {
  local host="$1" secret_file="$2" keyed_marker="$3" pubkey
  command -v ssh-copy-id >/dev/null 2>&1 || return 0
  pubkey="$(ensure_default_key).pub"
  echo "conn: installing your SSH key on '$host' so you won't need the password next time..." >&2
  local copy_cmd
  copy_cmd="$(printf 'sshpass -f <(age -d -i %q %q) ssh-copy-id -o StrictHostKeyChecking=accept-new -i %q %q' \
    "$AGE_IDENTITY" "$secret_file" "$pubkey" "$host")"
  if bash -c "$copy_cmd"; then
    touch "$keyed_marker"
    echo "conn: key installed on '$host' — future connects will skip the password" >&2
  else
    echo "conn: could not install the key automatically this time; continuing with the stored password" >&2
  fi
}

# --- snippets -------------------------------------------------------------

snip_file() { printf '%s/%s.sh' "$SNIP_DIR" "$1"; }

cmd_snip_add() {
  local name="$1" file
  [[ -n "$name" ]] || die "usage: conn snip add NAME"
  ensure_dirs
  file="$(snip_file "$name")"
  [[ -f "$file" ]] || printf '# %s\n' "$name" > "$file"
  "${EDITOR:-nano}" "$file"
  echo "conn: saved snippet '$name' -> $file"
}

cmd_snip_ls() {
  ensure_dirs
  local f
  shopt -s nullglob
  for f in "$SNIP_DIR"/*.sh; do
    basename "$f" .sh
  done
  shopt -u nullglob
}

cmd_snip_rm() {
  local name="$1" file
  [[ -n "$name" ]] || die "usage: conn snip rm NAME"
  file="$(snip_file "$name")"
  [[ -f "$file" ]] || die "no such snippet: $name"
  rm -f "$file"
  echo "conn: removed snippet '$name'"
}

pick_snippet() {
  need_cmd fzf fzf
  local names
  names="$(cmd_snip_ls)"
  [[ -n "$names" ]] || die "no snippets yet — run: conn snip add NAME"
  printf '%s\n' "$names" | fzf --prompt='snippet> ' --height='~40%' --reverse \
    --preview="cat '$SNIP_DIR/{}.sh'" --preview-window=down:60%:wrap
}

# Types a snippet's body into a live tmux pane without submitting it — the
# last line sits at the prompt for review/editing; you press Enter yourself.
# (A multi-line snippet's earlier lines still contain real newlines, so
# those lines run as they're typed — only the final line waits.)
inject_snippet() {
  local pane="$1" file="$2" body
  body="$(cat "$file")"
  tmux send-keys -t "$pane" -l -- "$body"
}

# Invoked from the tmux popup keybinding: conn snip-popup '#{pane_id}'
# A plain numbered menu rather than fzf: type the number, press enter, done —
# and on an empty list or bad input it waits for a keypress instead of
# closing instantly (display-popup -E closes as soon as this exits).
cmd_snip_popup() {
  local pane="${1:?internal: missing target pane}"
  ensure_dirs
  local -a names=()
  local f
  shopt -s nullglob
  for f in "$SNIP_DIR"/*.sh; do
    names+=("$(basename "$f" .sh)")
  done
  shopt -u nullglob

  if [[ ${#names[@]} -eq 0 ]]; then
    echo "conn: no snippets yet — run: conn snip add NAME"
    read -r -p "(press enter to close) " _
    return
  fi

  local i
  for i in "${!names[@]}"; do
    printf '%2d) %s\n' "$((i + 1))" "${names[$i]}"
  done

  local choice name file
  read -r -p "snippet #: " choice
  if [[ ! "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#names[@]} )); then
    echo "conn: invalid selection: $choice"
    read -r -p "(press enter to close) " _
    return
  fi

  name="${names[$((choice - 1))]}"
  file="$(snip_file "$name")"
  inject_snippet "$pane" "$file"
}

cmd_snip_action() {
  local name="${1:-}" file body choice
  [[ -n "$name" ]] || name="$(pick_snippet)"
  [[ -n "$name" ]] || exit 0
  file="$(snip_file "$name")"
  [[ -f "$file" ]] || die "no such snippet: $name"
  body="$(cat "$file")"

  if [[ -n "${TMUX:-}" ]]; then
    choice="$(printf 'copy\nrun local\nrun on host\ninject into pane\n' | fzf --prompt="$name> " --height='~30%' --reverse)"
  else
    choice="$(printf 'copy\nrun local\nrun on host\n' | fzf --prompt="$name> " --height='~30%' --reverse)"
  fi

  case "$choice" in
    copy)
      if command -v termux-clipboard-set >/dev/null 2>&1; then
        printf '%s' "$body" | termux-clipboard-set
        echo "conn: copied '$name' to clipboard"
      else
        echo "conn: termux-clipboard-set not found; snippet body:"
        printf '%s\n' "$body"
      fi
      ;;
    "run local")
      bash "$file"
      ;;
    "run on host")
      local host
      host="$(pick_host)"
      [[ -n "$host" ]] || exit 0
      need_cmd ssh openssh
      ssh "$host" "$body"
      ;;
    "inject into pane")
      inject_snippet "$TMUX_PANE" "$file"
      ;;
    *) exit 0 ;;
  esac
}

cmd_snip() {
  local sub="${1:-}"
  case "$sub" in
    add) cmd_snip_add "${2:-}" ;;
    ls) cmd_snip_ls ;;
    rm) cmd_snip_rm "${2:-}" ;;
    "") cmd_snip_action ;;
    *) cmd_snip_action "$sub" ;;
  esac
}

cmd_bind_key() {
  local key="${1:-s}"
  ensure_dirs
  [[ -f "$TMUX_CONF" ]] || : > "$TMUX_CONF"
  if grep -q "conn snip-popup" "$TMUX_CONF" 2>/dev/null; then
    echo "conn: tmux binding already present in $TMUX_CONF (edit it by hand to change the key)"
    return
  fi
  {
    printf '\n# conn: snippet picker popup (added by "conn bind-key")\n'
    printf 'bind-key %s display-popup -E -w 80%% -h 70%% "conn snip-popup '"'"'#{pane_id}'"'"'"\n' "$key"
  } >> "$TMUX_CONF"
  echo "conn: bound prefix+$key to the snippet popup in $TMUX_CONF"
  echo "conn: reload tmux config with: tmux source-file $TMUX_CONF"
}

# --- secrets (age password holdouts) --------------------------------------

age_recipient() {
  [[ -f "$AGE_RECIPIENT_FILE" ]] || die "no age recipient at $AGE_RECIPIENT_FILE — run: conn secret init"
  cat "$AGE_RECIPIENT_FILE"
}

cmd_secret_init() {
  need_cmd age-keygen age
  ensure_dirs
  [[ -f "$AGE_IDENTITY" ]] && die "identity already exists: $AGE_IDENTITY"
  age-keygen -o "$AGE_IDENTITY" 2>/dev/null
  chmod 600 "$AGE_IDENTITY"
  grep '^# public key:' "$AGE_IDENTITY" | awk '{print $NF}' > "$AGE_RECIPIENT_FILE"
  echo "conn: created age identity at $AGE_IDENTITY (never sync this file)"
  echo "conn: recipient (public, safe to sync) saved to $AGE_RECIPIENT_FILE"
}

cmd_secret_add() {
  local host="${1:-}" recipient pw
  [[ -n "$host" ]] || die "usage: conn secret add HOST"
  need_cmd age age
  ensure_dirs
  [[ -f "$AGE_RECIPIENT_FILE" ]] || cmd_secret_init
  recipient="$(age_recipient)"
  read -r -s -p "Password for $host: " pw
  echo
  [[ -n "$pw" ]] || die "empty password, aborting"
  printf '%s' "$pw" | age -r "$recipient" -o "$SECRET_DIR/$host.age"
  unset pw
  echo "conn: stored encrypted password for '$host' -> $SECRET_DIR/$host.age"
  offer_autokey "$host"
}

cmd_secret_rm() {
  local host="${1:-}"
  [[ -n "$host" ]] || die "usage: conn secret rm HOST"
  rm -f "$SECRET_DIR/$host.age" "$SECRET_DIR/$host.keyed" "$SECRET_DIR/$host.autokey"
  echo "conn: removed stored secret for '$host'"
}

cmd_secret_ls() {
  ensure_dirs
  local f
  shopt -s nullglob
  for f in "$SECRET_DIR"/*.age; do
    basename "$f" .age
  done
  shopt -u nullglob
}

cmd_secret() {
  local sub="${1:-}"
  case "$sub" in
    init) cmd_secret_init ;;
    add) cmd_secret_add "${2:-}" ;;
    rm) cmd_secret_rm "${2:-}" ;;
    ls) cmd_secret_ls ;;
    *) die "usage: conn secret {init|add HOST|rm HOST|ls}" ;;
  esac
}

# --- widgetize --------------------------------------------------------------

cmd_widgetize() {
  local hosts host script
  hosts="$(list_hosts)"
  [[ -n "$hosts" ]] || die "no hosts in $SSH_CONFIG yet — run: conn add"
  mkdir -p "$SHORTCUTS_DIR"
  while IFS= read -r host; do
    script="$SHORTCUTS_DIR/ssh-$host.sh"
    {
      printf '#!/data/data/com.termux/files/usr/bin/bash\n'
      printf 'exec conn connect %q\n' "$host"
    } > "$script"
    chmod +x "$script"
    echo "conn: wrote $script"
  done <<< "$hosts"
  cat <<'EOF'

conn: install Termux:Widget from the SAME source as Termux itself
(F-Droid or GitHub — plugins must share Termux's signing key), then
long-press your home screen -> Widgets -> Termux:Widget, and pick one
of the shortcuts above.
EOF
}

# --- sync ---------------------------------------------------------------

cmd_sync() {
  ensure_dirs
  need_cmd git git
  local sub="${1:-}"
  case "$sub" in
    init)
      if git -C "$CONN_HOME" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "conn: $CONN_HOME is already a git repo"
      else
        git -C "$CONN_HOME" init
        cat > "$CONN_HOME/.gitignore" <<'EOF'
# never sync the decryption key
age/identity.txt
# never sync private keys, only public halves
id_*
!id_*.pub
*.pem
EOF
        git -C "$CONN_HOME" add snippets secrets .gitignore 2>/dev/null || true
        [[ -f "$AGE_RECIPIENT_FILE" ]] && git -C "$CONN_HOME" add "$AGE_RECIPIENT_FILE"
        git -C "$CONN_HOME" commit -m "conn: initial sync repo" || true
        echo "conn: initialized sync repo at $CONN_HOME"
        echo "conn: set a remote with: conn sync remote <url>"
      fi
      ;;
    remote)
      local url="${2:?usage: conn sync remote URL}"
      if git -C "$CONN_HOME" remote get-url origin >/dev/null 2>&1; then
        git -C "$CONN_HOME" remote set-url origin "$url"
      else
        git -C "$CONN_HOME" remote add origin "$url"
      fi
      echo "conn: sync remote set to $url"
      ;;
    push)
      git -C "$CONN_HOME" push -u origin HEAD
      ;;
    pull)
      git -C "$CONN_HOME" pull --rebase --autostash
      ;;
    ""|status)
      git -C "$CONN_HOME" add -A
      if [[ -n "$(git -C "$CONN_HOME" status --porcelain)" ]]; then
        git -C "$CONN_HOME" commit -m "conn sync $(date -Iseconds)" || \
          die "commit failed (see the git error above — first time here? run: git -C $CONN_HOME config user.email you@example.com && git -C $CONN_HOME config user.name 'Your Name')"
      else
        echo "conn: nothing to commit"
      fi
      if git -C "$CONN_HOME" remote get-url origin >/dev/null 2>&1; then
        git -C "$CONN_HOME" pull --rebase --autostash
        git -C "$CONN_HOME" push -u origin HEAD
      else
        echo "conn: no remote configured; run: conn sync remote <url>"
      fi
      ;;
    *) die "usage: conn sync {init|remote URL|push|pull|status}" ;;
  esac
}

# --- doctor ---------------------------------------------------------------

cmd_doctor() {
  local ok=1
  check() {
    if command -v "$1" >/dev/null 2>&1; then
      printf '  [x] %-24s %s\n' "$1" "found"
    else
      printf '  [ ] %-24s %s\n' "$1" "missing${2:+ (pkg install $2)}"
      [[ "${3:-}" == "required" ]] && ok=0
    fi
  }
  echo "Required:"
  check bash "" required
  check fzf fzf required
  check ssh openssh required
  check tmux tmux required
  echo "Optional:"
  check mosh mosh
  check age age
  check sshpass sshpass
  check git git
  check nano nano
  check termux-clipboard-set termux-api
  [[ -f "$SSH_CONFIG" ]] && echo "  [x] $SSH_CONFIG exists" || echo "  [ ] $SSH_CONFIG missing (run: conn add)"
  (( ok )) || die "missing required dependencies"
  echo "conn: all required dependencies present"
}

# --- dispatch ---------------------------------------------------------------

main() {
  ensure_dirs
  local cmd="${1:-connect}"
  [[ $# -gt 0 ]] && shift || true
  case "$cmd" in
    connect) cmd_connect "$@" ;;
    list) cmd_list "$@" ;;
    add) cmd_add "$@" ;;
    rm|delete) cmd_rm "$@" ;;
    edit) cmd_edit "$@" ;;
    keygen) cmd_keygen "$@" ;;
    snip) cmd_snip "$@" ;;
    snip-popup) cmd_snip_popup "$@" ;;
    bind-key) cmd_bind_key "$@" ;;
    secret) cmd_secret "$@" ;;
    widgetize) cmd_widgetize "$@" ;;
    sync) cmd_sync "$@" ;;
    doctor) cmd_doctor "$@" ;;
    help|-h|--help) usage ;;
    -m) cmd_connect -m "$@" ;;
    *)
      # allow `conn HOST` as shorthand for `conn connect HOST`
      if [[ "$cmd" == -* ]]; then
        die "unknown flag: $cmd (see: conn help)"
      fi
      cmd_connect "$cmd" "$@"
      ;;
  esac
}

main "$@"
